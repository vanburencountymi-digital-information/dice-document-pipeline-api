# Required — no default. Generate with django.core.management.utils.get_random_secret_key
SECRET_KEY=
DATABASE_URL=postgres://dice:dice@db:5432/dice_document_pipeline

# The following are optional as they have defaults in settings.py; set as needed.
# DEBUG=False  (the default; set True for local development only)
# REQUIRE_HTTPS=True  (the default: https redirect, HSTS and https-only cookies. For LOCAL development you must set this to False, or http://localhost won't work. Never False in staging or production)
# ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_TASKS_BACKEND=django_tasks_db.DatabaseBackend
# MAX_WEBHOOK_ATTEMPTS=5
# DEFAULT_MAX_IN_FLIGHT=10  (a new service account's cap on documents waiting or being worked on)
# DEFAULT_RATE_LIMIT_COUNT=100  (a new service account's submissions per day)
# FAILED_AUTH_RATE=100/hour  (wrong-token attempts allowed per IP address)
# TRUSTED_PROXY_HOPS=0  (X-Forwarded-For entries the hosting platform adds; 0 for local development, must be 1 on Cloud Run)
# CLIENT_IP_RATE=120/minute  (most requests of any kind per IP address, a loose backstop; not applied to unlimited accounts)
# STUCK_QUEUED_MINUTES=60  (a resubmitted document still queued this long is queued again)
# STUCK_RUNNING_MINUTES=180  (same for one still running; about the longest a job can take)
# SECURE_HSTS_SECONDS=3600  (how long browsers insist on https; 0 when REQUIRE_HTTPS is False. Raise once stable)
# CSRF_TRUSTED_ORIGINS=https://pipeline.example.org  (only for a custom domain in front of the app)
# WEBHOOK_BACKOFF_BASE_SECONDS=30
# OCR_READY_TIMEOUT_SECONDS=600  (scheduled worker only: how long to wait for OCR to load)
# OCR_READY_POLL_SECONDS=5

# Remediation pipeline step toggles — default False (step is skipped) until its service
# class is built and you deliberately want it running.
# RUN_PRECHECK=False
# RUN_OCR=False
# RUN_FONT_REPAIR=False
# RUN_FINALIZE_METADATA=False
# RUN_LINK_TAG=False
# RUN_ALT_TEXT=False
# RUN_SCORING=False
# RUN_POSTCHECK=False

# ADR 0004's OpenDataLoader hybrid backend — docker-compose.yml already overrides
# this to the `opendataloader-hybrid` service's own DNS name; no need to set it locally.
# Required wherever RUN_OCR is on, or startup sends a warning to Sentry.
# OPENDATALOADER_HYBRID_URL=http://localhost:5002

# ADR 0005's alt-text engine (Claude Vision) — required if RUN_ALT_TEXT=True, a real
# per-figure API call and cost.
# ANTHROPIC_API_KEY=
# CLAUDE_VISION_MODEL=claude-sonnet-5
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Unset S3_BUCKET_NAME (the default) keeps local FileSystemStorage.
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION_NAME=auto
# S3_SIGNATURE_VERSION=s3v4
# S3_ADDRESSING_STYLE=path (Needed for both R2 and Garage)

# Nightly database backup (`manage.py backup_database`, DIC-2540): a separate bucket and token
# from the documents above. Unset, the command fails with an error instead of writing to disk.
# DB_BACKUP_BUCKET_NAME=
# DB_BACKUP_ACCESS_KEY=
# DB_BACKUP_SECRET_KEY=
