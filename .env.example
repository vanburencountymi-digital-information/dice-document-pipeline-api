# Copy this file to .env, fill in your values, then load it before running.
# NEVER commit .env — it is in .gitignore.
#
# Windows (PowerShell):  Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; [System.Environment]::SetEnvironmentVariable($k,$v) }
# Windows (cmd):         for /f "tokens=1,2 delims==" %i in (.env) do set %i=%j
# Linux/Mac (bash):      export $(grep -v '^#' .env | xargs)

# Required: Anthropic API key for Claude Haiku
# Used for: alt text generation, heading detection, color contrast checks
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: override tool paths if not at the default Windows locations
# POPPLER_PATH=C:\poppler\Library\bin
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# GHOSTSCRIPT_PATH=C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe
