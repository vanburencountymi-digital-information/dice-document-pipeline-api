# Required — no default. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DATABASE_URL=postgres://dice:dice@db:5432/dice_document_pipeline

# The following are optional as they have defaults in settings.py; set as needed.
# DEBUG=False  (the default; set True for local development only)
# ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_TASKS_BACKEND=django_tasks_db.DatabaseBackend
# MAX_WEBHOOK_ATTEMPTS=5
# SECURE_COOKIES=  (HTTPS-only login cookies; defaults to on whenever DEBUG is off)
# CSRF_TRUSTED_ORIGINS=https://pipeline.example.org  (only for a custom domain in front of the app)
# WEBHOOK_BACKOFF_BASE_SECONDS=30

# Remediation pipeline step toggles — default False (step is skipped) until its service
# class is built and you deliberately want it running.
# RUN_PRECHECK=False
# RUN_OCR=False
# RUN_FONT_REPAIR=False
# RUN_FINALIZE_METADATA=False
# RUN_LINK_TAG=False
# RUN_ALT_TEXT=False
# RUN_SCORING=False
# RUN_POSTCHECK=False

# ADR 0004's OpenDataLoader hybrid backend — docker-compose.yml already overrides
# this to the `opendataloader-hybrid` service's own DNS name; no need to set it.
# OPENDATALOADER_HYBRID_URL=http://localhost:5002

# ADR 0005's alt-text engine (Claude Vision) — required if RUN_ALT_TEXT=True, a real
# per-figure API call and cost.
# ANTHROPIC_API_KEY=
# CLAUDE_VISION_MODEL=claude-sonnet-5
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Unset S3_BUCKET_NAME (the default) keeps local FileSystemStorage.
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION_NAME=auto
# S3_SIGNATURE_VERSION=s3v4
# S3_ADDRESSING_STYLE=path (Needed for both R2 and Garage)
