# Copy to terraform.tfvars (not committed) and fill in.
project_id      = "ada-document-pipeline-prod"
public_hostname = "api.example.org"

s3_bucket_name  = "REPLACE-with-prod-bucket"
s3_endpoint_url = "https://ACCOUNT_ID.r2.cloudflarestorage.com"

# A separate private bucket for nightly database backups, not the documents bucket.
db_backup_bucket_name = "REPLACE-with-prod-backup-bucket"

# Only if the project doesn't exist yet:
# create_project  = true
# billing_account = "000000-000000-000000"

# Leave false for the first apply. See README.md.
deploy_cloud_run = false
# app_image        = "us-central1-docker.pkg.dev/ada-document-pipeline-prod/dice/app:v1.2.3"
# ocr_image        = "us-central1-docker.pkg.dev/ada-document-pipeline-prod/dice/opendataloader-hybrid:abc1234"

# From the Cloudflare dashboard: the account ID, and the Overview page of the zone that holds
# public_hostname. The API token goes in the CLOUDFLARE_API_TOKEN environment variable.
cloudflare_account_id = "REPLACE-with-account-id"
cloudflare_zone_id    = "REPLACE-with-zone-id"

# The WordPress host's IP, so the backfill's bursts skip the Cloudflare rate limit. Leave empty
# until the backfill; the app's own limits still apply.
# backfill_ips = ["203.0.113.10"]
