# Adobe PDF Services API credentials
# Sign up at https://acrobatservices.adobe.com/dc-integration-creation-app-cdn/main.html
# Free tier: 500 document transactions/month
# Auto-tag costs 10 transactions per page — a 20-page doc = 200 transactions
#
# Copy this file to .env and fill in your credentials (never commit .env)

PDF_SERVICES_CLIENT_ID=your_client_id_here
PDF_SERVICES_CLIENT_SECRET=your_client_secret_here
