# opendataloader-pdf's AI backend server — the "--hybrid docling-fast" mode ADR 0004
# decided on. A separate process/image from the main app on purpose: it needs
# Docling + PyTorch (multi-GB, no musl/Alpine wheels), while the main app only needs
# the lightweight `opendataloader-pdf` client (pure Python, talks to this server over
# HTTP) plus Java for its own local-processing core. See ADR 0004's Consequences and
# this repo's main Dockerfile header.
#
# Docling's model weights are baked in at build time (via `docling-tools
# models download` near the bottom of this file), so a cold start container never
# has to reach out to HuggingFace on its first real request.
#
# DOCLING_ARTIFACTS_PATH expects docling-tools' own flat
# layout and fails validation against anything else at runtime).
FROM python:3.12-slim

ENV DOCLING_ARTIFACTS_PATH=/opt/docling-models

# Docling's DataLoader always requests pin_memory=True regardless of whether a GPU is
# present (no config knob for this — it's internal to the opendataloader-pdf-hybrid
# package), so on CPU-only hosts torch emits this UserWarning on every batch. Harmless,
# but floods the logs; filtered by module since we can't fix the call site itself.
ENV PYTHONWARNINGS="ignore::UserWarning:torch.utils.data.dataloader"

# Docling defaults to torch.compile()-ing its layout/classification/VLM models for a
# speed boost, but that JIT-compiles a CPU kernel via torch._inductor, which needs a
# C++ compiler — this image is python:3.12-slim on purpose and has none. Without this,
# every real conversion 500s with "InvalidCxxCompiler: No working C++ compiler found".
# Disabling compilation just means eager-mode inference (slower, still correct) instead
# of pulling in a full g++ toolchain for a performance-only optimization.
ENV DOCLING_INFERENCE_COMPILE_TORCH_MODELS=false

# easyocr (Docling's default OCR engine, per ADR 0004's Backlog note) imports cv2
# (OpenCV), which needs a handful of X11 shared libraries even when running fully
# headless — python:3.12-slim doesn't ship them. Without this, the server 500s on
# every real conversion with "ImportError: libxcb.so.1: cannot open shared object
# file" (or the next one in this same chain, once that's fixed).
#
# git: TODO(docling PRs #3933, #3938, plus an unfiled containment-ratio cell-dedup fix)
# — temporary, needed only because requirements-opendataloader-hybrid.txt installs our
# patched docling fork (branch combined-bugfix-fork) via a `git+https://` URL instead
# of a PyPI release (same pattern as the main Dockerfile's opendataloader-pdf fork, see
# ADR 0010). Remove once all three fixes are merged/released and that requirements line
# reverts to letting opendataloader-pdf's own docling[easyocr]>=2.91.0 dependency
# resolve normally.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libxcb1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-opendataloader-hybrid.txt .
RUN pip install --no-cache-dir -r requirements-opendataloader-hybrid.txt

# Pre-bake the models this pipeline actually uses: layout + table structure
# (StandardPdfPipeline defaults) and easyocr (ADR 0004's OCR engine).
RUN docling-tools models download --output-dir /opt/docling-models layout tableformer easyocr

EXPOSE 5002
CMD ["opendataloader-pdf-hybrid", "--port", "5002"]
